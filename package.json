{
  "name": "@cairn-tool/cairn",
  "version": "2.0.0",
  "type": "module",
  "description": "An agent-agnostic CLI toolkit for working with markdown files and related assets",
  "license": "MIT",
  "author": "Bryan Stockus",
  "keywords": [
    "markdown",
    "cli",
    "lint",
    "markdownlint",
    "mermaid",
    "katex",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cairn-tool/cairn.git"
  },
  "bugs": {
    "url": "https://github.com/cairn-tool/cairn/issues"
  },
  "homepage": "https://github.com/cairn-tool/cairn#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "bin": {
    "cairn": "./dist/cli.js"
  },
  "files": [
    "dist",
    ".markdownlintrc",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "github-slugger": "^2.0.0",
    "jsdom": "^30.0.1",
    "katex": "^0.18.1",
    "markdownlint": "^0.41.1",
    "mermaid": "^11.12.0",
    "minimatch": "^10.2.6",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jsdom": "^21.1.0",
    "@types/katex": "^0.16.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.4.0",
    "semantic-release": "^25.0.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
